{
  "name": "@pavelpotemkin/portals-market-api-sdk",
  "version": "2.1.0",
  "description": "Typed client for the Portals Market Partner API (generated zod schemas, Result-based errors, retries, rate limiting)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PavelPotemkin/portals-market-api-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check src tests scripts spec",
    "lint:fix": "biome check --fix src tests scripts spec",
    "format": "biome format --write src tests scripts spec",
    "prepublishOnly": "npm run generate:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
